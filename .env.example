# Copy to .env (gitignored) for the Telegram CLI: make telegram-webhook, make telegram-poll,
# node scripts/telegram.js info. Variables set in the shell take precedence.

# From @BotFather. Never commit it.
TELEGRAM_BOT_TOKEN=

# Deployment that `make telegram-webhook` points the bot at (override with URL=...).
TELEGRAM_WEBHOOK_BASE_URL=https://glow-grid.erwann.app

# Optional: only if you don't want the secret derived from the token.
# Must match the value on Vercel.
# TELEGRAM_WEBHOOK_SECRET=

# Optional: let `make telegram-poll` use Redis instead of memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
